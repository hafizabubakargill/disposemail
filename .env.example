# Copy to .env (never commit .env) or set these in the hosting panel.
# Generate secrets with: openssl rand -hex 32

# Shared secret between the Cloudflare Worker and the server (must match the worker's WEBHOOK_SECRET)
WEBHOOK_SECRET=

# Signs session tokens for live inbox rooms
JWT_SECRET=

# MongoDB connection string
MONGODB_URI=

# Cloudflare Turnstile (contact form)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Contact form SMTP
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# Optional: Google Indexing API service-account JSON
GOOGLE_INDEXING_CREDENTIALS=

PORT=3000
