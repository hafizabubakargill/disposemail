{
    "manifest_version": 3,
    "name": "DisposeMail — Instant Temp Email",
    "version": "1.1.0",
    "description": "Generate a disposable email address instantly. Protect your real inbox from spam and data breaches.",
    "permissions": [
        "storage",
        "clipboardWrite",
        "activeTab"
    ],
    "action": {
        "default_popup": "popup.html",
        "default_title": "DisposeMail",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content.js"
            ],
            "css": [
                "content.css"
            ],
            "run_at": "document_idle"
        }
    ],
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "host_permissions": [
        "<all_urls>"
    ]
}